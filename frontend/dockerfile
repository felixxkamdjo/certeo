# Build stage with Node and pnpm
FROM node:22-alpine AS build
WORKDIR /app

# Enable corepack and configure non-interactive CI environment
ENV CI=true
RUN corepack enable && corepack prepare pnpm@latest --activate

# Cache dependencies
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --dangerously-allow-all-builds

# Build Angular application for production
COPY . .
RUN pnpm run build --configuration production

# Production web server stage
FROM nginx:alpine AS runtime
COPY --from=build /app/dist/certeo/browser /usr/share/nginx/html

# Copy custom Nginx routing configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
